          "raw": "{{base_url}}/employees/1",
          "host": ["{{base_url}}"],
          "path": ["employees", "1"]
        }
      },
      "response": []
    },
    {
      "name": "Update Employee",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"salary\": 91000.00,\n    \"department\": \"Regional Manager\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{base_url}}/employees/1",
          "host": ["{{base_url}}"],
          "path": ["employees", "1"]
        }
      },
      "response": []
