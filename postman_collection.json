      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"first_name\": \"Michael\",\n    \"last_name\": \"Scott\",\n    \"email\": \"michael.scott@dundermifflin.com\",\n    \"department\": \"Management\",\n    \"salary\": 85000.00,\n    \"hire_date\": \"2023-08-01\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{base_url}}/employees/",
          "host": ["{{base_url}}"],
          "path": ["employees", ""]
        }
      },
      "response": []
    },
    {
      "name": "Get All Employees",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/employees/",
          "host": ["{{base_url}}"],
          "path": ["employees", ""]
        }
      },
      "response": []
    },
    {
      "name": "Get Employee by ID",
      "request": {
        "method": "GET",
        "header": [],
