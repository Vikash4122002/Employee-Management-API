    {
      "name": "Delete Employee",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{base_url}}/employees/3",
          "host": ["{{base_url}}"],
          "path": ["employees", "3"]
        }
      },
      "response": []
